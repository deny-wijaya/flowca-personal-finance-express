#!/bin/sh
# Menolak push kalau typecheck, lint (aturan layer), atau test (termasuk architecture test) gagal.
# Build dan test Postgres tidak dijalankan di sini supaya push tetap cepat; keduanya dicek di CI.
echo "pre-push: typecheck, lint, test..."
npm run --silent typecheck && npm run --silent lint && npm test --silent
