# development | test | production
NODE_ENV=development

# Port server. Frontend next-personal-finance memanggil http://localhost:4000/api/v1
PORT=4000

# Prefix semua endpoint API
API_PREFIX=/api/v1

# Origin browser yang boleh memanggil API, dipisah koma.
# Next memanggil API dari server (Server Component/Action), jadi CORS baru terpakai
# kalau suatu saat browser memanggil API secara langsung.
CORS_ORIGINS=http://localhost:3200

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Koneksi ke Postgres di Docker (lihat compose.yaml). Port 5433, bukan 5432,
# supaya tidak bentrok dengan Postgres Homebrew.
DATABASE_URL=postgres://finance:finance@localhost:5433/personal_finance

# Kunci tanda tangan JWT (minimal 32 karakter). Buat yang baru dengan: openssl rand -base64 48
JWT_SECRET=ganti-dengan-hasil-openssl-rand-base64-48
# Masa berlaku access token dalam detik (86400 = 1 hari)
JWT_EXPIRES_IN=86400

# Alamat yang boleh mengirim X-Forwarded-For (IP asli user dari server Next). "loopback" = mesin yang sama.
# Saat deploy, isi dengan IP atau subnet server Next. Jangan isi "true", karena siapa pun bisa memalsukan IP-nya.
TRUST_PROXY=loopback
